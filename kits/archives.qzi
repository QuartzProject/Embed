package org.quartzlang.embed.archives

/// The names of the files in a zip or jar.
fn entries(archive: str) -> [str]
/// Extracts a zip or jar into a directory; returns how many files it wrote. An entry that would land outside traps.
fn unzip(archive: str, target: str) -> int
/// Extracts a .tar or .tar.gz into a directory; returns how many files it wrote.
fn untar(archive: str, target: str) -> int
/// Zips every file under a directory; returns how many it added.
fn zip(directory: str, archive: str) -> int
