import org.quartzlang.embed.fs
import org.quartzlang.embed.terminal.{println, eprintln}
import org.quartzlang.embed.process.{args, exit}

fn main() {
    let files = args()
    if files.len() == 0 {
        eprintln("usage: qwc <file>...")
        exit(2)
    }
    var total = 0
    for name in files {
        match fs.readText(name) {
            Ok(text) => {
                let lines = text.split("\n").len() - 1
                total += lines
                println("{lines} {name}")
            }
            Err(why) => {
                eprintln("qwc: {why}")
                exit(1)
            }
        }
    }
    println("{total} total")
}
